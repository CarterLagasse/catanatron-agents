# The public site: the built UI and the game server as one app, sized for a free host.
# Build Command:
# docker build -t catanatron-deploy:latest . -f Dockerfile.deploy
FROM node:24-alpine AS ui

WORKDIR /ui

COPY ui/package.json ui/package-lock.json ui/.npmrc ./
RUN npm ci

COPY ui/ ./
RUN npm run build


FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY catanatron/ catanatron/
RUN pip install --no-cache-dir .[web,jax]

COPY agents/ agents/
COPY --from=ui /ui/dist ui-dist/

ENV CATANATRON_UI_DIST=/app/ui-dist
ENV WIN_ODDS_SIMULATIONS=25
ENV MAX_SAVED_GAMES=50
ENV JAX_PLATFORMS=cpu
ENV PYTHONUNBUFFERED=1
ENV PORT=10000

EXPOSE 10000

# One worker keeps one copy of the agents in memory. Loading an agent on a small CPU
# takes close to gunicorn's default 30 s limit.
CMD exec gunicorn --bind 0.0.0.0:$PORT --workers 1 --threads 4 --timeout 120 "catanatron.web:create_app()"
